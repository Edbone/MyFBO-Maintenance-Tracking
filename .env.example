NODE_ENV=production
PORT=3100
HOST=127.0.0.1

# Set to "myfbo" to use the built-in MyFBO navigation flow.
FBO_VENDOR=myfbo

# When true, scraper generates sample data instead of logging into the FBO site.
MOCK_MODE=true

# Scraper timing
SCRAPE_TIMEOUT_MS=45000
REFRESH_INTERVAL_MINUTES=180

# FBO login
FBO_LOGIN_URL=https://your-fbo.example.com/login
FBO_MAINTENANCE_URL=https://your-fbo.example.com/maintenance
FBO_USERNAME=replace_me
FBO_PASSWORD=replace_me

# MyFBO-specific optional settings
MYFBO_ORG_ID=
MYFBO_REPORT_TYPE=summary

# Optional browser launch override
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_VIEWPORT_WIDTH=1440
PLAYWRIGHT_VIEWPORT_HEIGHT=1200

# Optional dashboard protection
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASS=

# Override data storage location if needed
DATA_DIR=./data
